"""Talk to the agent in a terminal, as one of your users:

    uv run -m {package}.chat --user dana

Each run is a new conversation; what the agent remembers from the last one is memory's.
"""

from __future__ import annotations

import argparse
import asyncio
import uuid

from agents import TResponseInputItem
from dotenv import load_dotenv

load_dotenv()

from {package}.agent import reply  # noqa: E402 - after .env, which the model reads
from {package}.memory import MemoryContext  # noqa: E402


async def main() -> None:
    parser = argparse.ArgumentParser(description="Talk to the agent.")
    parser.add_argument("--user", default="dana", help="whose memory the agent reads")
    user = parser.parse_args().user
    context = MemoryContext(user_id=user, session_id=uuid.uuid4().hex)
    print(f"Talking as {user}. An empty line ends the conversation.")
    history: list[TResponseInputItem] = []
    while line := input("you> ").strip():
        result = await reply([*history, {"role": "user", "content": line}], context)
        history = result.to_input_list()
        print(f"agent> {result.final_output}")


if __name__ == "__main__":
    asyncio.run(main())
