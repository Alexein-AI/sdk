"""The crew: one assistant that remembers the person it works for.

Made by `alexein-cli create crewai`. Memory comes from `memory.py`, beside it.
"""

from __future__ import annotations

import os
from typing import Any

from crewai import Agent, Crew, Task
from crewai.project import CrewBase, agent, before_kickoff, crew, task

from {package}.memory import alexein_memory, whose

# The model, as CrewAI names it: MODEL in .env.
MODEL: Any = os.environ.get("MODEL", "{model}")


@CrewBase
class {crew_class}:
    agents_config = "config/agents.yaml"
    tasks_config = "config/tasks.yaml"

    # CrewAI recalls the user's memory before the task and saves what it found after;
    # whose() takes the user from the run's inputs.
    memory = alexein_memory

    @before_kickoff
    def whose_memory(self, inputs: dict[str, Any]) -> dict[str, Any]:
        return whose(inputs)

    @agent
    def assistant(self) -> Agent:
        return Agent(config=self.agents_config["assistant"], llm=MODEL)

    @task
    def answer(self) -> Task:
        return Task(config=self.tasks_config["answer"])

    @crew
    def crew(self) -> Crew:
        return Crew(agents=self.agents, tasks=self.tasks, memory=self.memory)
