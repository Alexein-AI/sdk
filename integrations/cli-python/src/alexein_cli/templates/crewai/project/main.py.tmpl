"""Ask the crew something, as one of your users:

    uv run run_crew --user dana "Where do I live these days?"

Each run is a new conversation; what the crew remembers from the last one is memory's.
"""

from __future__ import annotations

import argparse

from dotenv import load_dotenv

load_dotenv()

# After .env: the model and memory read their keys from it.
from {package}.crew import {crew_class}  # noqa: E402


def ask(user_id: str, question: str) -> str:
    """One run of the crew for `user_id`; its reply."""
    crew = {crew_class}().crew()
    out = crew.kickoff(inputs={"user_id": user_id, "question": question})
    return str(getattr(out, "raw", out))


def run() -> None:
    parser = argparse.ArgumentParser(description="Ask the crew something.")
    parser.add_argument("--user", default="dana", help="whose memory the crew reads")
    parser.add_argument("question", nargs="+", help="what to ask")
    args = parser.parse_args()
    print(ask(args.user, " ".join(args.question)))


if __name__ == "__main__":
    run()
