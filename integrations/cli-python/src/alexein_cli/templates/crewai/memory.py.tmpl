"""Long-term memory for this crew, from Alexein.

Generated by `alexein-cli init crewai` (alexein-cli {version}); yours to edit. The
settings are here; the memory comes from `alexein.crewai`
(https://docs.alexein.ai/integrations/crewai).

`alexein_memory` is CrewAI's own memory, kept in Alexein: CrewAI recalls the user's
memory before every task, saves what each task learned, and gives agents memory tools.

    Crew(..., memory=alexein_memory, before_kickoff_callbacks=[whose])

or, in a @CrewBase class, `memory = alexein_memory` and a @before_kickoff method that
returns `whose(inputs)`; or, in crew.jsonc:

    "memory": {"python": "memory.alexein_memory"},
    "before_kickoff_callbacks": [{"python": "memory.whose"}]

Whose memory is read is your code's choice, never the model's: every kickoff names the
app user, `crew.kickoff(inputs={"user_id": "dana", ...})`. The key is ALEXEIN_API_KEY
and the address ALEXEIN_API_URL, read on the first call: importing needs neither.
"""

from typing import Any

from alexein.crewai import AlexeinMemory

# True skips search's relevance check: free and quicker, a little less precise.
FAST = {fast}

# False keeps your crew running while memory is down: a task goes on without its
# memory, a save is skipped, and a warning is logged on the `alexein` logger. True
# stops a run at kickoff instead (CrewAI itself carries on past what memory raises
# during a task). A wrong key stops the run at kickoff either way.
STRICT = False

# How much of what memory holds goes into a prompt, in characters.
MAX_CHARS = 4000

# Seconds each attempt at a call may take; a call is tried up to three times. A task
# waits for its recall and saves.
TIMEOUT = 10.0

alexein_memory = AlexeinMemory(
    fast=FAST,
    max_chars=MAX_CHARS,
    strict=STRICT,
    timeout=TIMEOUT,
)


def whose(inputs: dict[str, Any]) -> dict[str, Any]:
    """Before each kickoff: the app user from `inputs["user_id"]`, and the key checked
    once. A function rather than `alexein_memory.whose`, because CrewAI keeps only
    module-level callbacks when it restores a checkpoint."""
    return alexein_memory.whose(inputs)
