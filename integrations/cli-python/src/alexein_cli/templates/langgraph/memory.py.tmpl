"""Long-term memory for this graph, from Alexein.

Generated by `alexein-cli init langgraph` (alexein-cli {version}); yours to edit. The
settings are here; the nodes and tools come from `alexein.langgraph`
(https://docs.alexein.ai/integrations/langgraph).

    builder = StateGraph(MemoryState, context_schema=MemoryContext)
    builder.add_node("recall", memory.recall)  # before your model: what memory holds
    builder.add_node("agent", agent)  # yours: memory.prompt(state) in its prompt
    builder.add_node("remember", memory.remember)  # after it: save the turn

Or tools the model calls itself: `create_agent(model, tools=memory.tools(), ...)`, and
`memory.tools(write=True)` to let it save too.

Whose memory is read is your code's choice, never the model's: run with
`context={"user_id": "dana"}`; the thread id is the session. The key is ALEXEIN_API_KEY
and the address ALEXEIN_API_URL, read on the first call: importing needs neither.
"""

from alexein.langgraph import AlexeinMemory, MemoryContext, MemoryState

__all__ = ["MemoryContext", "MemoryState", "memory"]

# True skips search's relevance check: free and quicker, a little less precise. Use it
# where a reply cannot wait, like a voice agent's turn.
FAST = {fast}

# False keeps the graph running while memory is down: a turn goes on without its
# memory, a save is skipped, and a warning is logged on the `alexein` logger. True
# raises instead. A wrong key raises either way: that is a mistake to fix.
STRICT = False

# How much of what memory holds goes into the prompt, in characters.
MAX_CHARS = 4000

# Seconds each attempt at a call may take; a call is tried up to three times.
TIMEOUT = 10.0

# Runs under invoke and ainvoke; memory.arecall and memory.aremember are async nodes.
memory = AlexeinMemory(
    fast=FAST,
    max_chars=MAX_CHARS,
    strict=STRICT,
    timeout=TIMEOUT,
)
