/**
 * Long-term memory for this graph, from Alexein. Generated by
 * `npx @alexein/cli init langgraph` (@alexein/cli {version}); yours to edit.
 * The settings are here; the nodes and tools come from @alexein/sdk/langgraph.
 *
// >>> nodes
 *     import { memory, MemoryAnnotation, MemoryContext } from "./memory.js";
// <<< nodes
// >>> tools_only
 *     import { memory, MemoryContext } from "./memory.js";
// <<< tools_only
// >>> nodes
 *
 *     const graph = new StateGraph(MemoryAnnotation, MemoryContext)
 *       .addNode("recall", memory.recall) // what memory holds, into state
 *       .addNode("agent", agent) // yours: memory.prompt(state) in its prompt
 *       .addNode("remember", memory.remember) // save the turn
 *       .addEdge(START, "recall")
 *       .addEdge("recall", "agent")
 *       .addEdge("agent", "remember")
 *       .compile();
// <<< nodes
// >>> both
 *
 *     // and the model can look things up itself: memory_search, memory_open
 *     const tools = memory.tools();
 *     createAgent({ model, tools, contextSchema: MemoryContext });
// <<< both
// >>> tools_only
 *
 *     // memory_search and memory_open, and memory_add to save
 *     const tools = memory.tools({ write: true });
 *     createAgent({ model, tools, contextSchema: MemoryContext });
// <<< tools_only
 *
 * Whose memory is read is your code's choice, never the model's: run with
 * `{ context: { user_id: "dana" }, configurable: { thread_id: "t-1" } }`.
 * The key is ALEXEIN_API_KEY and the address ALEXEIN_API_URL, read on first use.
 */

import { AlexeinMemory } from "@alexein/sdk/langgraph";

/** True skips search's relevance check: free and quicker, less precise. */
export const FAST = {fast};
/** False goes on without memory while it is down, logging it; true throws. */
export const STRICT = false;
/** How much of what memory holds goes into the prompt, in characters. */
export const MAX_CHARS = 4000;
/** Milliseconds each attempt at a call may take; a call tries three times. */
export const TIMEOUT = 10_000;

// The client is made on first use, so importing this file needs no key.
export const memory = new AlexeinMemory({
  fast: FAST,
  maxChars: MAX_CHARS,
  strict: STRICT,
  timeout: TIMEOUT,
});

// >>> nodes
// The state with `memory` in it (an Annotation, or the same as a StateSchema),
// and the run's context schema, `{ user_id }`.
export {
  MemoryAnnotation,
  MemoryContext,
  MemoryState,
} from "@alexein/sdk/langgraph";
// <<< nodes
// >>> tools_only
// The run's context schema, `{ user_id }`.
export { MemoryContext } from "@alexein/sdk/langgraph";
// <<< tools_only
