/**
 * The agent: a model that remembers the people it talks to.
 *
 * Made by `npx @alexein/cli create langgraph`. Memory comes from `memory.ts`, beside it:
// >>> nodes
 * `memory.recall` looks up what memory holds before the model answers, and
 * `memory.remember` saves the turn after it.
// <<< nodes
// >>> both
 * The model can also search memory itself, with `memory.tools()`.
// <<< both
// >>> tools_only
 * The model searches memory and saves to it itself, with `memory.tools({ write: true })`.
// <<< tools_only
 *
 * Whose memory a run reads is the `user_id` in its context, which your code sets:
 *
 *     await graph.invoke(inputs, { context: { user_id: "dana" } });
 */

import { SystemMessage } from "@langchain/core/messages";
// >>> nodes
import { END, START, StateGraph } from "@langchain/langgraph";
// <<< nodes
// >>> tools_only
import {
  END,
  MessagesAnnotation,
  START,
  StateGraph,
} from "@langchain/langgraph";
// <<< tools_only
// >>> tools
import { ToolNode, toolsCondition } from "@langchain/langgraph/prebuilt";
// <<< tools
import { initChatModel } from "langchain";

// >>> nodes
import { memory, MemoryAnnotation, MemoryContext } from "./memory.js";
// <<< nodes
// >>> tools_only
import { memory, MemoryContext } from "./memory.js";
// <<< tools_only
// >>> tools_only

const State = MessagesAnnotation;
// <<< tools_only
// >>> nodes

const State = MemoryAnnotation;
// <<< nodes
// >>> both

// `memory.remember` saves every turn, so the model is only given the tools that read.
const TOOLS = memory.tools();
// <<< both
// >>> tools_only

// Nothing else saves, so the model is given the tool that does.
const TOOLS = memory.tools({ write: true });
// <<< tools_only

const SYSTEM =
  "You are a helpful assistant. You remember the people you talk to across " +
  "conversations; use what you remember where it helps, and never invent it.";

/** The chat model `MODEL` in .env names, made on first use. */
let chat: ReturnType<typeof bind> | undefined;

async function bind() {
  const name = process.env.MODEL ?? "{model}";
  const model = await initChatModel(name);
// >>> tools
  return model.bindTools(TOOLS);
// <<< tools
// >>> nodes_only
  return model;
// <<< nodes_only
}

export async function agent(state: typeof State.State) {
  let system = SYSTEM;
// >>> nodes
  const remembered = memory.prompt(state);
  if (remembered) system += "\n\n" + remembered;
// <<< nodes
  chat ??= bind();
  const model = await chat;
  const reply = await model.invoke([
    new SystemMessage(system),
    ...state.messages,
  ]);
  return { messages: [reply] };
}

export const graph = new StateGraph(State, MemoryContext)
  .addNode("agent", agent)
// >>> nodes
  .addNode("recall", memory.recall)
  .addNode("remember", memory.remember)
// <<< nodes
// >>> tools
  .addNode("tools", new ToolNode(TOOLS))
// <<< tools
// >>> nodes
  .addEdge(START, "recall")
  .addEdge("recall", "agent")
  .addEdge("remember", END)
// <<< nodes
// >>> tools_only
  .addEdge(START, "agent")
// <<< tools_only
// >>> tools
  .addEdge("tools", "agent")
// <<< tools
// >>> both
  .addConditionalEdges("agent", toolsCondition, {
    tools: "tools",
    [END]: "remember",
  })
// <<< both
// >>> tools_only
  .addConditionalEdges("agent", toolsCondition, { tools: "tools", [END]: END })
// <<< tools_only
// >>> nodes_only
  .addEdge("agent", "remember")
// <<< nodes_only
  .compile();
