/**
 * Long-term memory for your agents, from Alexein. Generated by
 * `npx @alexein/cli init openai-agents` (@alexein/cli {version}); yours to edit.
 * The settings are here; recall, remember and the tools come from
 * @alexein/sdk/openai-agents.
 *
 *     import { memory, type MemoryContext } from "./memory.js";
// >>> both
 *
 *     // the model can look things up itself: memory_search, memory_open
 *     const agent = new Agent({ name: "Bot", tools: memory.tools() });
// <<< both
// >>> tools_only
 *
 *     // memory_search and memory_open, and memory_add to save
 *     const tools = memory.tools({ write: true });
 *     const agent = new Agent({ name: "Bot", tools });
// <<< tools_only
// >>> nodes
 *
 *     const result = await run(agent, message, {
 *       context: { userId: "dana", sessionId: "conv-7" },
 *       callModelInputFilter: memory.recall, // into instructions, not history
 *     });
 *     await memory.remember(result); // a stream: once `completed` resolves
// <<< nodes
 *
 * Whose memory is read is your code's choice, never the model's: the run's
 * `context.userId`; its `sessionId` (optional) groups what is saved.
 * The key is ALEXEIN_API_KEY and the address ALEXEIN_API_URL, read on first use.
 */

import { AlexeinMemory } from "@alexein/sdk/openai-agents";

/** True skips search's relevance check: free and quicker, less precise. */
export const FAST = {fast};
/** False goes on without memory while it is down, logging it; true throws. */
export const STRICT = false;
/** How much of what memory holds goes into the prompt, in characters. */
export const MAX_CHARS = 4000;
/** Milliseconds each attempt at a call may take; a call tries three times. */
export const TIMEOUT = 10_000;

// The client is made on first use, so importing this file needs no key.
export const memory = new AlexeinMemory({
  fast: FAST,
  maxChars: MAX_CHARS,
  strict: STRICT,
  timeout: TIMEOUT,
});

/** Whose memory a run reads, as its context: `{ userId, sessionId? }`. */
export type { MemoryContext } from "@alexein/sdk/openai-agents";
