{
  "name": "twinmemory-cli",
  "version": "0.1.0",
  "description": "Add memory from Alexein to a LangGraph.js or OpenAI Agents SDK project, as code you own: npx twinmemory-cli init langgraph.",
  "license": "MIT",
  "author": "Alexein AI",
  "homepage": "https://docs.alexein.ai/integrations/langgraph",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexein-AI/twin-memory-integrations.git",
    "directory": "packages/js"
  },
  "keywords": [
    "memory",
    "llm",
    "agents",
    "langgraph",
    "openai-agents",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "twinmemory-cli": "dist/bin.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit && prettier --check . && vitest run",
    "test": "vitest run",
    "format": "prettier --write .",
    "prepublishOnly": "node -e \"if (/^file:/.test(require('./package.json').dependencies.twinmemory)) { console.error('twinmemory must come from npm: publish it first, then depend on it by version'); process.exit(1) }\" && npm run check && npm run build"
  },
  "dependencies": {
    "twinmemory": "file:../../vendor/twinmemory-0.1.0.tgz"
  },
  "devDependencies": {
    "@langchain/core": "^1.2.0",
    "@langchain/langgraph": "^1.5.0",
    "@openai/agents": "^0.21.0",
    "@types/node": "^22.10.0",
    "langchain": "^1.5.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "zod": "^4.0.0"
  }
}
