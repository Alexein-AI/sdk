{
  "name": "@alexein/cli",
  "version": "0.3.0",
  "description": "Add memory from Alexein to a LangGraph.js or OpenAI Agents SDK project: npx @alexein/cli init langgraph writes a short memory.ts you own, on @alexein/sdk.",
  "license": "MIT",
  "author": "Alexein AI",
  "homepage": "https://docs.alexein.ai/integrations/langgraph",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexein-AI/sdk.git",
    "directory": "integrations/cli-js"
  },
  "bugs": {
    "url": "https://github.com/Alexein-AI/sdk/issues"
  },
  "keywords": [
    "alexein",
    "memory",
    "llm",
    "agents",
    "langgraph",
    "openai-agents",
    "cli"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "alexein-cli": "dist/bin.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "check": "tsc --noEmit && prettier --check . && vitest run",
    "test": "vitest run",
    "format": "prettier --write .",
    "prepublishOnly": "node -e \"if (/^file:/.test(require('./package.json').dependencies['@alexein/sdk'])) { console.error('@alexein/sdk must come from npm: publish it first, then depend on it by version'); process.exit(1) }\" && npm run check && npm run build"
  },
  "dependencies": {
    "@alexein/sdk": "file:../../typescript"
  },
  "devDependencies": {
    "@langchain/core": "^1.3.0",
    "@langchain/langgraph": "^1.6.0",
    "@openai/agents": "^0.21.0",
    "@types/node": "^22.10.0",
    "langchain": "^1.6.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "zod": "^4.0.0"
  }
}
