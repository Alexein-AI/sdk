{
  "name": "@alexein/sdk",
  "version": "0.3.1",
  "description": "JavaScript and TypeScript client for Alexein: long-term memory for your users and agents, with LangGraph.js and OpenAI Agents SDK integrations.",
  "license": "MIT",
  "author": "Alexein AI",
  "homepage": "https://docs.alexein.ai/sdks/typescript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexein-AI/sdk.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/Alexein-AI/sdk/issues"
  },
  "keywords": [
    "alexein",
    "memory",
    "long-term-memory",
    "agents",
    "ai-agents",
    "langgraph",
    "openai-agents"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./langgraph": {
      "import": {
        "types": "./dist/langgraph.d.ts",
        "default": "./dist/langgraph.js"
      },
      "require": {
        "types": "./dist/langgraph.d.cts",
        "default": "./dist/langgraph.cjs"
      }
    },
    "./openai-agents": {
      "import": {
        "types": "./dist/openai-agents.d.ts",
        "default": "./dist/openai-agents.js"
      },
      "require": {
        "types": "./dist/openai-agents.d.cts",
        "default": "./dist/openai-agents.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "langgraph": [
        "./dist/langgraph.d.ts"
      ],
      "openai-agents": [
        "./dist/openai-agents.d.ts"
      ]
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.cjs",
    "dist/*.d.ts",
    "dist/*.d.cts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "check": "tsc --noEmit && prettier --check . && vitest run",
    "test": "vitest run",
    "format": "prettier --write .",
    "prepublishOnly": "npm run check && npm run build"
  },
  "peerDependencies": {
    "@langchain/core": ">=1.0.0 <2.0.0",
    "@langchain/langgraph": ">=1.0.0 <2.0.0",
    "@openai/agents": ">=0.21.0 <1.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "@langchain/langgraph": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "^1.3.0",
    "@langchain/langgraph": "^1.6.0",
    "@openai/agents": "^0.21.0",
    "@types/node": "^22.10.0",
    "langchain": "^1.6.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "zod": "^4.0.0"
  }
}
