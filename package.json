{
  "name": "twinmemory",
  "version": "0.1.0",
  "description": "JavaScript and TypeScript client for twin memory: long-term memory for your users and agents.",
  "license": "MIT",
  "author": "Alexein AI",
  "homepage": "https://twinmemory.dev/docs/sdks/typescript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexein-AI/twin-memory-js.git"
  },
  "keywords": [
    "memory",
    "llm",
    "agents",
    "ai",
    "rag"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit && prettier --check . && vitest run",
    "test": "vitest run",
    "format": "prettier --write .",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
