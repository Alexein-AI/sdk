{
	"name": "n8n-nodes-twinmemory",
	"version": "0.1.0",
	"description": "n8n node for twin memory: long-term memory for your users and AI agents.",
	"license": "MIT",
	"homepage": "https://twinmemory.dev/docs/integrations/n8n",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"memory",
		"ai-agent",
		"llm"
	],
	"author": {
		"name": "Alexein AI",
		"email": "abdulrehman@alexein.ai"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Alexein-AI/twin-memory-integrations.git",
		"directory": "packages/n8n"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "n8n-node build && node --test \"test/*.test.mjs\""
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/TwinMemoryApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/TwinMemory/TwinMemory.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
