import { z } from "zod";

/**
 * False asks memory's model filter to keep only what the question needs: the most
 * precise answer, and one paid call per search. True skips it: free and quicker, a
 * little less precise. Use true where a reply cannot wait, like a voice agent's turn.
 */
export const FAST = {fast};

/**
 * False keeps your graph running when memory is unreachable, slow or failing: a
 * turn goes ahead without its memory, a save is skipped, and a warning is logged.
 * True throws instead. A wrong key throws either way: that is a mistake to fix, not
 * an outage to ride out.
 */
export const STRICT = false;

/** How much of what memory holds goes into the prompt, in characters. */
export const MAX_CHARS = 4000;

/**
 * Milliseconds a call to memory may take before the turn goes on without it (each
 * call is tried up to three times when memory is busy or unreachable).
 */
export const TIMEOUT = 10_000;

/**
 * Whose memory a run reads. Pass it as the context schema of your graph, or add
 * `user_id: z.string()` to a context schema you already have.
 */
export const MemoryContext = z.object({ user_id: z.string() });
// >>> nodes

/**
 * Your graph's state with room for what `recall` found. Use it, or add
 * `memory: z.string().default("")` to a state of your own.
 */
export const MemoryState = new StateSchema({
  messages: MessagesValue,
  memory: z.string().default(""),
});
// <<< nodes

/** What a node or tool is handed about its run: its context and thread. */
interface RunConfig {
  context?: unknown;
  configurable?: Record<string, unknown>;
}

let client: Memory | undefined;

/** One client for the process, made on first use: importing needs no key. */
function memory(): Memory {
  client ??= new Memory({
    failOpen: !STRICT,
    integration: "langgraph",
    timeout: TIMEOUT,
  });
  return client;
}

/** Use a client of your own instead: another key, or a stand-in in tests. */
export function useMemory(given: Memory): void {
  client = given;
}

/**
 * The end user this run is for: `context: { user_id }`, else
 * `configurable.user_id`.
 */
function userId(config: RunConfig | undefined): string {
  const context = config?.context as { user_id?: unknown } | undefined;
  const found = context?.user_id ?? config?.configurable?.user_id;
  if (!found) {
    throw new Error(
      "twin memory needs to know whose memory this is: run the graph with " +
        '{ context: { user_id: "..." } }, or { configurable: { user_id: "..." } }',
    );
  }
  return String(found);
}

function user(config: RunConfig | undefined): User {
  return memory().user(userId(config));
}

function threadId(config: RunConfig | undefined): string | undefined {
  const thread = config?.configurable?.thread_id;
  return thread === undefined ? undefined : String(thread);
}

async function search(
  who: User,
  query: string,
): Promise<SearchResult | undefined> {
  try {
    return await who.search(query, { fast: FAST });
  } catch (error) {
    if (error instanceof NotFoundError) return undefined; // nothing saved yet
    throw error;
  }
}
// >>> nodes

// ------------------------------------------------------------------------ nodes --

type State = typeof MemoryState.State;

function last<T extends BaseMessage>(
  messages: BaseMessage[],
  kind: abstract new (...args: never[]) => T,
): T | undefined {
  return messages.findLast((m): m is T => m instanceof kind);
}

/** Look up what memory holds for the user's latest message, into `memory`. */
export async function recall(
  state: State,
  config?: RunConfig,
): Promise<Partial<State>> {
  const asked = last(state.messages, HumanMessage);
  if (!asked?.text.trim()) return { memory: "" };
  const found = await search(user(config), asked.text);
  return { memory: found ? found.context(MAX_CHARS) : "" };
}

/**
 * What `recall` found, as a block for your system prompt; empty when it found
 * nothing.
 */
export function memoryPrompt(state: { memory?: string }): string {
  if (!state.memory) return "";
  return (
    "What you remember about this user from earlier conversations. Use it " +
    "where it helps; the conversation itself takes precedence where they " +
    "differ.\n\n" +
    state.memory
  );
}

/**
 * Save this turn - the user's latest message and the reply to it - to the user's
 * memory.
 *
 * Each message is saved under its own LangGraph id, so running a turn again
 * replaces what was saved rather than adding a second copy. Tool calls and tool
 * results are not saved. Needs a key that writes.
 */
export async function remember(
  state: State,
  config?: RunConfig,
): Promise<Partial<State>> {
  const asked = last(state.messages, HumanMessage);
  const replies = state.messages.filter(
    (m): m is AIMessage => m instanceof AIMessage && !m.tool_calls?.length,
  );
  const thread = threadId(config);
  const items = [
    item(asked, "user", thread),
    item(replies.at(-1), "assistant", thread),
  ].filter((said): said is Item => said !== undefined);
  if (items.length) await user(config).add(items, { session: thread });
  return {};
}

function item(
  message: BaseMessage | undefined,
  role: string,
  thread: string | undefined,
): Item | undefined {
  if (!message?.text.trim()) return undefined;
  const said = `${thread}|${role}|${message.text}`;
  const id =
    message.id ?? createHash("sha256").update(said).digest("hex").slice(0, 24);
  return { id, role, text: message.text };
}
