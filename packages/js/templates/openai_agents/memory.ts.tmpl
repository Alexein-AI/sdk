// >>> tools

// ------------------------------------------------------------------------ tools --
// The run context is filled in by the runner and never shown to the model, so a
// model cannot ask for anybody else's memory.

export const UNAVAILABLE =
  "Memory is unavailable right now; carry on without it.";

/**
 * What the model is told when a tool fails: that memory is down, or what was wrong
 * with what it asked, so it can carry on or try again. A wrong key, a run with no
 * user in its context, or an outage under STRICT throws: those are yours to fix.
 */
function toolFailed(run: RunContext<unknown>, error: unknown): string {
  const yours =
    error instanceof AuthenticationError ||
    error instanceof PermissionDeniedError;
  const outage = error instanceof TwinMemoryError && error.outage;
  const noUser = !(run.context as Partial<MemoryContext> | undefined)?.userId;
  if (yours || noUser || (STRICT && outage)) throw error;
  if (outage) {
    console.warn(`twin memory unavailable: ${(error as Error).message}`);
    return UNAVAILABLE;
  }
  return `That did not work: ${error instanceof Error ? error.message : error}`;
}

export const memorySearch = tool({
  name: "memory_search",
  description:
    "Search what you remember about this user: what they said, did and decided " +
    "in earlier conversations. Ask in plain language. Ends with the paths of what " +
    "it found, to read whole with memory_read.",
  parameters: z.object({ query: z.string().describe("What to look for") }),
  errorFunction: toolFailed,
  async execute({ query }, run?: RunContext<unknown>) {
    const found = await search(user(run?.context), query);
    if (found?.failed) return UNAVAILABLE;
    const said = found?.context(MAX_CHARS) ?? "";
    if (!said) return "Nothing remembered about that.";
    const sources = found!.facts.flatMap((f) => (f.source ? [f.source] : []));
    const paths = [...new Set([...found!.hits.map((h) => h.path), ...sources])];
    if (!paths.length) return said;
    const listed = paths.map((p) => `- ${p}`).join("\n");
    return `${said}\n\nTo read one whole, memory_read:\n${listed}`;
  },
});

export const memoryRead = tool({
  name: "memory_read",
  description:
    "Read one remembered passage or record whole, by a path memory_search gave.",
  parameters: z.object({
    path: z.string().describe("A path memory_search gave"),
  }),
  errorFunction: toolFailed,
  async execute({ path }, run?: RunContext<unknown>) {
    try {
      const found = await user(run?.context).read(path);
      return found.text ?? found.error ?? `Nothing at ${path}.`;
    } catch (error) {
      if (!(error instanceof NotFoundError)) throw error;
      return "Nothing has been remembered for this user yet.";
    }
  },
});

export const memoryAdd = tool({
  name: "memory_add",
  description:
    "Remember something about this user for later conversations: a preference, " +
    "a fact about them, a decision. Write it as one plain sentence. Never save " +
    "passwords, keys or secrets.",
  parameters: z.object({ text: z.string().describe("One plain sentence") }),
  errorFunction: toolFailed,
  async execute({ text }, run?: RunContext<unknown>) {
    const saved = await user(run?.context).add(text, {
      kind: "note",
      session: sessionId(run?.context),
    });
    return saved.failed ? UNAVAILABLE : "Saved.";
  },
});

export const MEMORY_TOOLS = [memorySearch, memoryRead];
export const MEMORY_WRITE_TOOLS = [...MEMORY_TOOLS, memoryAdd];
// <<< tools
