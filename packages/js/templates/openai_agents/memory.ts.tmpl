/**
 * False asks memory's model filter to keep only what the question needs: the most
 * precise answer, and one paid call per search. True skips it: free and quicker, a
 * little less precise. Use true where a reply cannot wait, like a voice agent's turn.
 */
export const FAST = {fast};

/**
 * False keeps your agent running when memory is unreachable, slow or failing: a
 * turn goes ahead without its memory, a save is skipped, and a warning is logged.
 * True throws instead. A wrong key throws either way: that is a mistake to fix, not
 * an outage to ride out.
 */
export const STRICT = false;

/** How much of what memory holds goes into the prompt, in characters. */
export const MAX_CHARS = 4000;

/**
 * Milliseconds a call to memory may take before the turn goes on without it (each
 * call is tried up to three times when memory is busy or unreachable).
 */
export const TIMEOUT = 10_000;

/**
 * Whose memory a run reads: pass it as the run's `context`, or give a context of
 * your own a `userId` (and, if you like, a `sessionId`).
 */
export interface MemoryContext {
  userId: string;
  sessionId?: string;
}

let client: Memory | undefined;

/** One client for the process, made on first use: importing needs no key. */
function memory(): Memory {
  client ??= new Memory({
    failOpen: !STRICT,
    integration: "openai-agents",
    timeout: TIMEOUT,
  });
  return client;
}

/** Use a client of your own instead: another key, or a stand-in in tests. */
export function useMemory(given: Memory): void {
  client = given;
}

/** The end user this run is for, from its context; never from the model. */
function user(context: unknown): User {
  const found = (context as Partial<MemoryContext> | undefined)?.userId;
  if (!found) {
    throw new Error(
      "twin memory needs to know whose memory this is: run the agent with " +
        '{ context: { userId: "..." } }',
    );
  }
  return memory().user(String(found));
}

function sessionId(context: unknown): string | undefined {
  const found = (context as Partial<MemoryContext> | undefined)?.sessionId;
  return found ? String(found) : undefined;
}

/**
 * The longest question memory takes, in characters. A longer one - a pasted email -
 * is searched by its end, where its question usually is.
 */
const MAX_QUERY = 2000;

async function search(
  who: User,
  query: string,
): Promise<SearchResult | undefined> {
  try {
    return await who.search(query.slice(-MAX_QUERY), { fast: FAST });
  } catch (error) {
    if (error instanceof NotFoundError) return undefined; // nothing saved yet
    throw error;
  }
}
// >>> nodes

// ------------------------------------------------------------ recall, remember --

/** What a message says, whether its content is a string or a list of parts. */
function text(item: AgentInputItem): string {
  const content = "content" in item ? item.content : undefined;
  if (typeof content === "string") return content;
  if (!Array.isArray(content)) return "";
  return content
    .flatMap((part) =>
      "text" in part && typeof part.text === "string" ? [part.text] : [],
    )
    .join("\n");
}

function saidByUser(item: AgentInputItem): boolean {
  return "role" in item && item.role === "user";
}

/**
 * The user's message when this model call is the first of a turn - the input ends
 * with it, or with developer or system messages after it - else undefined.
 */
function asked(items: AgentInputItem[]): string | undefined {
  for (let i = items.length - 1; i >= 0; i--) {
    const role = "role" in items[i]! ? (items[i] as { role: string }).role : "";
    if (role === "developer" || role === "system") continue;
    return role === "user" ? text(items[i]!).trim() : undefined;
  }
  return undefined;
}

/**
 * What `recall` found for each run - its context object - for the model calls after
 * the first in a turn (a tool loop, a handoff), whose input no longer ends with the
 * user's message. Per run, so two turns in flight for one user keep their own.
 */
const recalled = new WeakMap<object, string>();

/** What goes before what memory found, in the instructions. */
const HEADING =
  "What you remember about this user from earlier conversations. Use it where " +
  "it helps; the conversation itself takes precedence where they differ.\n\n";

/**
 * `callModelInputFilter: recall`: before the model, what memory holds for the
 * user's latest message, added to the instructions.
 */
export async function recall({
  modelData,
  context,
}: CallModelInputFilterArgs<unknown>): Promise<ModelInputData> {
  const who = user(context);
  const run = context as object;
  let question = asked(modelData.input);
  if (question === undefined && !recalled.has(run)) {
    // A run resumed after an approval, or in another process: nothing kept for it.
    const said = modelData.input.findLast(saidByUser);
    question = said && text(said).trim();
  }
  if (question !== undefined) {
    const found = question ? await search(who, question) : undefined;
    const block = found?.context(MAX_CHARS) ?? "";
    recalled.set(run, block ? HEADING + block : "");
  }
  const block = recalled.get(run);
  if (!block) return modelData;
  const given = modelData.instructions;
  return { ...modelData, instructions: given ? `${given}\n\n${block}` : block };
}

/**
 * Save the turn a run answered - the user's latest message and the final output -
 * to the user's memory, under the agent's name. Call it once the run is done (for
 * a stream, once `completed` resolves).
 *
 * Each message is saved under an id made from the run's response and its text, so
 * saving the same result again replaces what was saved rather than adding a second
 * copy. Tool calls and their results are not saved. A run paused for an approval
 * saves nothing: save the run that resumes it. Needs a key that writes.
 */
export async function remember(
  result: RunResult<any, any> | StreamedRunResult<any, any>,
): Promise<void> {
  if (result.interruptions?.length) return;
  const context: unknown = result.runContext.context;
  const session = sessionId(context);
  const said: AgentInputItem[] =
    typeof result.input === "string"
      ? [{ role: "user", content: result.input }]
      : result.input;
  const asked = said.findLast(saidByUser);
  const turn = `${session}|${turnOf(result)}`;
  const items = [
    item(asked ? text(asked) : "", "user", turn),
    item(answer(result.finalOutput), "assistant", turn, result.lastAgent?.name),
  ].filter((said): said is Item => said !== undefined);
  if (items.length) await user(context).add(items, { session });
}

/** Ids made for results whose model gave no response id. */
const turns = new WeakMap<object, string>();

/**
 * What sets this run's saves apart from another's with the same words: the model's
 * response id, or - from a model that gives none, as Chat Completions does - one
 * made for this result, so that saving it again still replaces rather than adds.
 */
function turnOf(result: object & { lastResponseId?: string }): string {
  if (result.lastResponseId) return result.lastResponseId;
  const made = turns.get(result) ?? randomUUID();
  turns.set(result, made);
  return made;
}

/** The final output as text: a string as it is, structured output as JSON. */
function answer(output: unknown): string {
  if (output === undefined || output === null) return "";
  return typeof output === "string" ? output : JSON.stringify(output);
}

function item(
  said: string,
  role: string,
  turn: string,
  author?: string,
): Item | undefined {
  if (!said.trim()) return undefined;
  const id = createHash("sha256")
    .update(`${turn}|${role}|${said}`)
    .digest("hex")
    .slice(0, 24);
  return { id, role, text: said, ...(author ? { author } : {}) };
}
