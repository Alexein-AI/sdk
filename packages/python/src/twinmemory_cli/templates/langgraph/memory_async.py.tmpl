class MemoryState(MessagesState):
    """Your graph's state with room for what `recall` found. Subclass it, or add a
    `memory: str` key to a state of your own."""

    memory: str
# <<< nodes


class MemoryContext(TypedDict):
    """Whose memory a run reads. Pass it as `context_schema=` to your graph, or add
    `user_id: str` to a context schema you already have."""

    user_id: str


@cache
def _memory() -> AsyncMemory:
    """One client for the process, made on first use: importing needs no key. It
    belongs to the event loop it is first used on, as a server's single loop is."""
    return AsyncMemory(fail_open=not STRICT, integration="langgraph", timeout=TIMEOUT)


def _user_id(context: Any, config: RunnableConfig | None) -> str:
    """The end user this run is for: `context={"user_id": ...}` (a dict, or any
    object with a `user_id`), else `config["configurable"]["user_id"]`."""
    if isinstance(context, dict):
        found = context.get("user_id")
    else:
        found = getattr(context, "user_id", None)
    if not found and config:
        found = config.get("configurable", {}).get("user_id")
    if not found:
        raise ValueError(
            "twin memory needs to know whose memory this is: run the graph with "
            'context={"user_id": "..."}, or config={"configurable": {"user_id": "..."}}'
        )
    return str(found)


def _user(context: Any, config: RunnableConfig | None = None) -> AsyncUser:
    return _memory().user(_user_id(context, config))


def _thread_id(config: RunnableConfig | None) -> str | None:
    return (config or {}).get("configurable", {}).get("thread_id")


async def _search(user: AsyncUser, query: str) -> SearchResult | None:
    try:
        return await user.search(query, fast=FAST)
    except NotFoundError:  # nothing has been saved for this user yet
        return None
# >>> nodes


def _last(messages: list[AnyMessage], kind: type[AnyMessage]) -> AnyMessage | None:
    return next((m for m in reversed(messages) if isinstance(m, kind)), None)


# --------------------------------------------------------------------------- nodes --


async def recall(
    state: MemoryState, runtime: Runtime, config: RunnableConfig
) -> dict[str, Any]:
    """Look up what memory holds for the user's latest message, into
    `state["memory"]`."""
    asked = _last(state["messages"], HumanMessage)
    if asked is None or not asked.text.strip():
        return {"memory": ""}
    found = await _search(_user(runtime.context, config), asked.text)
    return {"memory": found.context(max_chars=MAX_CHARS) if found else ""}


def memory_prompt(state: MemoryState) -> str:
    """What `recall` found, as a block for your system prompt; empty when it found
    nothing."""
    found = state.get("memory") or ""
    if not found:
        return ""
    return (
        "What you remember about this user from earlier conversations. Use it where "
        "it helps; the conversation itself takes precedence where they differ.\n\n"
        + found
    )


async def remember(
    state: MemoryState, runtime: Runtime, config: RunnableConfig
) -> dict[str, Any]:
    """Save this turn - the user's latest message and the reply to it - to the
    user's memory.

    Each message is saved under its own LangGraph id, so running a turn again
    replaces what was saved rather than adding a second copy. Tool calls and tool
    results are not saved. Needs a key that writes."""
    messages = state["messages"]
    asked = _last(messages, HumanMessage)
    replies = [m for m in messages if isinstance(m, AIMessage) and not m.tool_calls]
    answered = replies[-1] if replies else None
    thread = _thread_id(config)
    items = [
        _item(message, role, thread)
        for message, role in ((asked, "user"), (answered, "assistant"))
        if message is not None and message.text.strip()
    ]
    if items:
        await _user(runtime.context, config).add(items, session=thread)
    return {}


def _item(message: AnyMessage, role: str, thread: str | None) -> Item:
    said = f"{thread}|{role}|{message.text}"
    ident = message.id or hashlib.sha256(said.encode()).hexdigest()[:24]
    return Item(id=ident, role=role, text=message.text)
