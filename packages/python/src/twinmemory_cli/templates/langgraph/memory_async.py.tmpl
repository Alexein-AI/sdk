# --------------------------------------------------------------------------- tools --
# `runtime` is filled in by LangGraph and never shown to the model, so a model cannot
# ask for anybody else's memory.

UNAVAILABLE = "Memory is unavailable right now; carry on without it."


def _unavailable(error: TwinMemoryError) -> str:
    """What the model is told when memory is down, unless STRICT; a wrong key or a
    wrong request raises."""
    if STRICT or not error.outage:
        raise error
    log.warning("twin memory unavailable: %s", error)
    return UNAVAILABLE


@tool
async def memory_search(query: str, runtime: ToolRuntime[Any, Any]) -> str:
    """Search what you remember about this user: what they said, did and decided in
    earlier conversations. Ask in plain language. Ends with the paths of what it
    found, to read whole with memory_read."""
    found = await _search(_user(runtime.context, runtime.config), query)
    if found is not None and found.failed:
        return UNAVAILABLE
    text = found.context(max_chars=MAX_CHARS) if found else ""
    if not found or not text:
        return "Nothing remembered about that."
    sources = [f.source for f in found.facts if f.source]
    paths = dict.fromkeys([h.path for h in found.hits] + sources)
    if paths:
        listed = "\n".join(f"- {p}" for p in paths)
        text += f"\n\nTo read one whole, memory_read:\n{listed}"
    return text


@tool
async def memory_read(path: str, runtime: ToolRuntime[Any, Any]) -> str:
    """Read one remembered passage or record whole, by a path memory_search gave."""
    try:
        found = await _user(runtime.context, runtime.config).read(path)
    except NotFoundError:
        return "Nothing has been remembered for this user yet."
    except TwinMemoryError as error:
        return _unavailable(error)
    if found.text is not None:
        return found.text
    return found.error or f"Nothing at {path}."


@tool
async def memory_add(text: str, runtime: ToolRuntime[Any, Any]) -> str:
    """Remember something about this user for later conversations: a preference, a
    fact about them, a decision. Write it as one plain sentence. Never save
    passwords, keys or secrets."""
    session = _thread_id(runtime.config)
    saved = await _user(runtime.context, runtime.config).add(
        text, kind="note", session=session
    )
    return UNAVAILABLE if saved.failed else "Saved."


MEMORY_TOOLS = [memory_search, memory_read]
MEMORY_WRITE_TOOLS = [*MEMORY_TOOLS, memory_add]
# <<< tools
