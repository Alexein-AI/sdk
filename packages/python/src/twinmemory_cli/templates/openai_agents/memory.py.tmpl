# False asks memory's model filter to keep only what the question needs: the most
# precise answer, and one paid call per search. True skips it: free and quicker, a
# little less precise. Use True where a reply cannot wait, like a voice agent's turn.
FAST = {fast}

# False keeps your agent running when memory is unreachable, slow or failing: a turn
# goes ahead without its memory, a save is skipped, and a warning is logged. True
# raises instead. A wrong key raises either way: that is a mistake to fix, not an
# outage to ride out.
STRICT = False

# How much of what memory holds goes into the prompt, in characters.
MAX_CHARS = 4000

# Seconds a call to memory may take before the turn goes on without it (each call is
# tried up to three times when memory is busy or unreachable).
TIMEOUT = 10.0

log = logging.getLogger(__name__)


@dataclass
class MemoryContext:
    """Whose memory a run reads: pass it as `context=` to `Runner.run`, or give a
    context of your own a `user_id` (and, if you like, a `session_id`)."""

    user_id: str
    session_id: str | None = None


@cache
def _memory() -> AsyncMemory:
    """One client for the process, made on first use: importing needs no key. It
    belongs to the event loop it is first used on, as a server's single loop is."""
    return AsyncMemory(
        fail_open=not STRICT, integration="openai-agents", timeout=TIMEOUT
    )


def _field(context: Any, name: str) -> Any:
    if isinstance(context, dict):
        return context.get(name)
    return getattr(context, name, None)


def _user(context: Any) -> AsyncUser:
    """The end user this run is for, from its context; never from the model."""
    found = _field(context, "user_id")
    if not found:
        raise ValueError(
            "twin memory needs to know whose memory this is: run the agent with "
            'context=MemoryContext(user_id="..."), or a context that has a user_id'
        )
    return _memory().user(str(found))


def _session(context: Any) -> str | None:
    found = _field(context, "session_id")
    return str(found) if found else None


# The longest question memory takes, in characters. A longer one - a pasted email - is
# searched by its end, where its question usually is.
_MAX_QUERY = 2000


async def _search(user: AsyncUser, query: str) -> SearchResult | None:
    try:
        return await user.search(query[-_MAX_QUERY:], fast=FAST)
    except NotFoundError:  # nothing has been saved for this user yet
        return None
