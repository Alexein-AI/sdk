# --------------------------------------------------------------------------- tools --
# The context is filled in by the Runner and never shown to the model, so a model
# cannot ask for anybody else's memory.

UNAVAILABLE = "Memory is unavailable right now; carry on without it."


def _tool_failed(ctx: RunContextWrapper[Any], error: Exception) -> str:
    """What the model is told when a tool fails: that memory is down, or what was wrong
    with what it asked, so it can carry on or try again. A wrong key, a run with no
    user in its context, or an outage under STRICT raises: those are yours to fix."""
    yours = isinstance(error, (AuthenticationError, PermissionDeniedError))
    outage = isinstance(error, TwinMemoryError) and error.outage
    if yours or not _field(ctx.context, "user_id") or (STRICT and outage):
        raise error
    if outage:
        log.warning("twin memory unavailable: %s", error)
        return UNAVAILABLE
    return f"That did not work: {error}"


@function_tool(failure_error_function=_tool_failed)
async def memory_search(ctx: RunContextWrapper[Any], query: str) -> str:
    """Search what you remember about this user: what they said, did and decided in
    earlier conversations. Ends with the paths of what it found, to read whole with
    memory_read.

    Args:
        query: What to look up, in plain language.
    """
    found = await _search(_user(ctx.context), query)
    if found is not None and found.failed:
        return UNAVAILABLE
    text = found.context(max_chars=MAX_CHARS) if found else ""
    if not found or not text:
        return "Nothing remembered about that."
    sources = [f.source for f in found.facts if f.source]
    paths = dict.fromkeys([h.path for h in found.hits] + sources)
    if paths:
        listed = "\n".join(f"- {p}" for p in paths)
        text += f"\n\nTo read one whole, memory_read:\n{listed}"
    return text


@function_tool(failure_error_function=_tool_failed)
async def memory_read(ctx: RunContextWrapper[Any], path: str) -> str:
    """Read one remembered passage or record whole.

    Args:
        path: A path memory_search gave.
    """
    try:
        found = await _user(ctx.context).read(path)
    except NotFoundError:
        return "Nothing has been remembered for this user yet."
    if found.text is not None:
        return found.text
    return found.error or f"Nothing at {path}."


@function_tool(failure_error_function=_tool_failed)
async def memory_add(ctx: RunContextWrapper[Any], text: str) -> str:
    """Remember something about this user for later conversations: a preference, a
    fact about them, a decision. Never save passwords, keys or secrets.

    Args:
        text: One plain sentence.
    """
    session = _session(ctx.context)
    saved = await _user(ctx.context).add(text, kind="note", session=session)
    return UNAVAILABLE if saved.failed else "Saved."


MEMORY_TOOLS = [memory_search, memory_read]
MEMORY_WRITE_TOOLS = [*MEMORY_TOOLS, memory_add]
# <<< tools
