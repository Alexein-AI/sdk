# ------------------------------------------------------------------ recall, remember --


def _text(item: TResponseInputItem) -> str:
    """What a message says, whether its content is a string or a list of parts."""
    content = item.get("content") if isinstance(item, dict) else None
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return ""
    parts = [p.get("text") for p in content if isinstance(p, dict)]
    return "\n".join(p for p in parts if isinstance(p, str))


def _said_by_user(item: TResponseInputItem) -> bool:
    return isinstance(item, dict) and item.get("role") == "user"


def _asked(items: list[TResponseInputItem]) -> str | None:
    """The user's message when this model call is the first of a turn - the input ends
    with it, or with developer or system messages after it - else None."""
    for item in reversed(items):
        role = item.get("role") if isinstance(item, dict) else None
        if role in ("developer", "system"):
            continue
        return _text(item).strip() if role == "user" else None
    return None


# What `recall` found for each run - its context object - and user, for the model
# calls after the first in a turn (a tool loop, a handoff), whose input no longer ends
# with the user's message. Per run, so two turns in flight for one user keep their own.
_recalled: dict[tuple[int, str], str] = {}
_KEPT = 1000

# What goes before what memory found, in the instructions.
_HEADING = (
    "What you remember about this user from earlier conversations. Use it where it "
    "helps; the conversation itself takes precedence where they differ.\n\n"
)


async def recall(data: CallModelData[Any]) -> ModelInputData:
    """`RunConfig(call_model_input_filter=recall)`: before the model, what memory holds
    for the user's latest message, added to the instructions."""
    model = data.model_data
    user = _user(data.context)
    run = (id(data.context), user.id)
    asked = _asked(model.input)
    if asked is None and run not in _recalled:
        # A run resumed after an approval, or in another process: nothing kept for it.
        said = [_text(i).strip() for i in model.input if _said_by_user(i)]
        asked = said[-1] if said else None
    if asked is not None:
        found = await _search(user, asked) if asked else None
        text = found.context(max_chars=MAX_CHARS) if found else ""
        _recalled.pop(run, None)  # to the end, so the oldest are dropped first
        _recalled[run] = _HEADING + text if text else ""
        while len(_recalled) > _KEPT:
            _recalled.pop(next(iter(_recalled)))
    block = _recalled.get(run, "")
    if block:
        given = model.instructions
        model.instructions = f"{given}\n\n{block}" if given else block
    return model


async def remember(result: RunResultBase) -> None:
    """Save the turn a run answered - the user's latest message and the final answer -
    to the user's memory, under the agent's name. Call it once the run is done (for
    `run_streamed`, once its events are consumed).

    Each message is saved under an id made from the run's response and its text, so
    saving the same result again replaces what was saved rather than adding a second
    copy. Tool calls and their results are not saved. A run paused for an approval
    saves nothing: save the run that resumes it. Needs a key that writes."""
    if getattr(result, "interruptions", None):
        return
    context = result.context_wrapper.context
    session = _session(context)
    said = ItemHelpers.input_to_new_input_list(result.input)
    asked = next((_text(i) for i in reversed(said) if _said_by_user(i)), "")
    answered = _answer(result.final_output)
    turn = _turn(result)
    items = [
        _item(text, role, f"{session}|{turn}", author)
        for text, role, author in (
            (asked, "user", None),
            (answered, "assistant", result.last_agent.name),
        )
        if text.strip()
    ]
    if items:
        await _user(context).add(items, session=session)


def _answer(output: Any) -> str:
    """The final output as text: a string as it is, structured output as JSON."""
    if output is None or isinstance(output, str):
        return output or ""
    dump = getattr(output, "model_dump_json", None)
    return dump() if callable(dump) else json.dumps(output, default=str)


def _turn(result: RunResultBase) -> str:
    """What sets this run's saves apart from another's with the same words: the model's
    response id, or - from a model that gives none, as Chat Completions does - one made
    for this result, so that saving it again still replaces rather than adds."""
    found = result.raw_responses[-1].response_id if result.raw_responses else None
    if not found:
        found = getattr(result, "_twin_memory_turn", None) or uuid.uuid4().hex
        result._twin_memory_turn = found  # type: ignore[attr-defined]
    return found


def _item(text: str, role: str, turn: str, author: str | None) -> Item:
    ident = hashlib.sha256(f"{turn}|{role}|{text}".encode()).hexdigest()[:24]
    item = Item(id=ident, role=role, text=text)
    if author:
        item["author"] = author
    return item
