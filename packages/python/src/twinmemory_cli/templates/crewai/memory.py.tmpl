# False asks memory's model filter to keep only what the question needs: the most
# precise answer, and one paid call per search. True skips it: free and quicker, a
# little less precise.
FAST = {fast}

# False keeps your crew running when memory is unreachable, slow or failing: a task
# goes ahead without its memory, a save is skipped, and a warning is logged. True
# raises instead. A wrong key raises either way, at kickoff: that is a mistake to fix,
# not an outage to ride out.
STRICT = False

# How much of what memory holds goes into a prompt, in characters.
MAX_CHARS = 4000

# Seconds a call to memory may take before the crew goes on without it (each call is
# tried up to three times when memory is busy or unreachable).
TIMEOUT = 10.0

log = logging.getLogger("twinmemory")


@cache
def _memory() -> Memory:
    """One client for the process, made on first use: importing needs no key."""
    return Memory(fail_open=not STRICT, integration="crewai", timeout=TIMEOUT)


def _search(user: User, query: str) -> SearchResult | None:
    try:
        return user.search(query, fast=FAST)
    except NotFoundError:  # nothing has been saved for this user yet
        return None


def _lines(found: SearchResult) -> list[tuple[str, str]]:
    """What a search found, best first, as (text, where it came from)."""
    lines = [(line, "") for line in found.known + found.worked_out]
    lines += [(fact.text, fact.source or fact.path) for fact in found.facts]
    lines += [(hit.text, hit.path) for hit in found.hits]
    return lines


def _within(lines: list[tuple[str, str]], limit: int) -> list[tuple[str, str]]:
    """At most `limit` lines, whole ones only, within MAX_CHARS in all."""
    kept: list[tuple[str, str]] = []
    total = 0
    for text, where in lines[:limit]:
        total += len(text)
        if kept and total > MAX_CHARS:
            break
        kept.append((text, where))
    return kept


def _id(*parts: str) -> str:
    return hashlib.sha256("|".join(parts).encode()).hexdigest()[:24]
# >>> auto


# ------------------------------------------------------------------- whose memory --
# The user is held per run, not on the memory object, so one TwinMemory serves every
# run - concurrent runs for different users included: each kickoff has a context of its
# own, and CrewAI saves in a copy of it.

_user: ContextVar[str | None] = ContextVar("twin_memory_user", default=None)
_session: ContextVar[str | None] = ContextVar("twin_memory_session", default=None)
_key_checked = False


def whose(inputs: dict[str, Any]) -> dict[str, Any]:
    """Before each kickoff: take the end user from the run's inputs, and check the key.

    Every run must name its user; a run without one stops here, before any task, so it
    can never inherit the last run's user. Returns the inputs without `user_id`."""
    user_id = inputs.pop("user_id", None)
    if not user_id or not isinstance(user_id, str):
        raise ValueError(
            "twin memory needs to know whose memory this is: kick off with "
            'inputs={"user_id": "..."}'
        )
    _check_key()
    _user.set(user_id)
    _session.set(uuid.uuid4().hex)
    return inputs


def _check_key() -> None:
    """Once per process, ask memory what the key is: CrewAI swallows memory's errors,
    so a wrong key found later would only switch memory off without a word."""
    global _key_checked
    if _key_checked:
        return
    try:
        _memory().me()
    except AuthenticationError:
        raise
    except TwinMemoryError as error:
        if not error.outage:
            raise
        log.warning("twin memory unavailable, key not checked: %s", error)
        return  # tried again on the next run
    _key_checked = True


def _current() -> User:
    user_id = _user.get()
    if not user_id:
        raise ValueError(
            "twin memory has no user for this run: kick off with "
            'inputs={"user_id": "..."}, with whose() as a before-kickoff callback'
        )
    return _memory().user(user_id)


# ------------------------------------------------------------------------ memory --


class _Nowhere:
    """Stands in for CrewAI's own storage, so no local vector store is ever made."""


class TwinMemory(CrewMemory):
    """CrewAI's memory, kept in twin memory: what CrewAI recalls before a task and saves
    after it go to the end user `whose()` set for the run."""

    def __init__(self, **fields: Any) -> None:
        fields.setdefault("storage", _Nowhere())
        super().__init__(**fields)

    def recall(
        self,
        query: str,
        scope: str | None = None,
        categories: list[str] | None = None,
        limit: int = 10,
        depth: Any = "deep",
        source: str | None = None,
        include_private: bool = False,
    ) -> list[MemoryMatch]:
        try:
            found = _search(_current(), query)
        except TwinMemoryError as error:
            log.warning("twin memory recall failed: %s", error)
            raise
        if found is None or found.failed:
            return []
        kept = _within(_lines(found), limit)
        return [
            MemoryMatch(
                record=MemoryRecord(content=text, metadata={"path": where}),
                score=round(1.0 - n / max(len(kept), 1) / 2, 3),
            )
            for n, (text, where) in enumerate(kept)
        ]

    def extract_memories(self, content: str) -> list[str]:
        """No model call: twin memory reads what it is given itself. A task that found
        nothing is not saved."""
        _, said, result = content.rpartition("\nResult:")
        return [content] if not said or result.strip() else []

    def remember(self, content: str, **fields: Any) -> MemoryRecord | None:
        self._save([content], fields.get("agent_role"))
        return MemoryRecord(content=content)

    def remember_many(self, contents: list[str], **fields: Any) -> list[MemoryRecord]:
        self._save(contents, fields.get("agent_role"))
        return [MemoryRecord(content=content) for content in contents]

    def _save(self, contents: list[str], role: str | None) -> None:
        contents = [c for c in contents if c.strip()]
        if not contents:
            return
        session = _session.get() or ""
        items: list[dict[str, Any]] = [
            {"id": _id(session, role or "", text), "kind": "note", "text": text}
            for text in contents
        ]
        try:
            user = _current()
            saved = user.add(items, session=session or None, author=role or None)
        except TwinMemoryError as error:
            log.warning("twin memory save failed: %s", error)
            raise
        if saved.failed:
            log.warning("twin memory unavailable, %d saves skipped", len(items))

    def forget(self, *args: Any, **kwargs: Any) -> int:
        raise NotImplementedError(
            "forget from twin memory with twinmemory: Memory().user(id).forget(...)"
        )

    def reset(self, *args: Any, **kwargs: Any) -> None:
        raise NotImplementedError("twin memory is not reset from a crew")


# One memory for a JSON crew to point at; it holds no user, so every run may share it.
twin_memory = TwinMemory()
