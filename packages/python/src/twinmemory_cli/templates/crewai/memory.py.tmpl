# ------------------------------------------------------------------------- tools --


class _Query(BaseModel):
    query: str = Field(description="What to look for, in plain language")


class _Path(BaseModel):
    path: str = Field(description="A path Search memory gave")


class _Note(BaseModel):
    text: str = Field(description="One plain sentence to remember")


class _MemoryTool(BaseTool):
    user_id: str = Field(exclude=True)

    def _user(self) -> User:
        return _memory().user(self.user_id)


class _Search(_MemoryTool):
    name: str = "Search memory"
    description: str = (
        "Search what you remember about this user: what they said, did and decided "
        "before. Ends with the paths of what it found, to read whole with Read memory."
    )
    args_schema: type[BaseModel] = _Query

    def _run(self, query: str) -> str:
        found = _search(self._user(), query)
        if found is not None and found.failed:
            return "Memory is unavailable right now; carry on without it."
        kept = _within(_lines(found), 20) if found else []
        if not kept:
            return "Nothing remembered about that."
        text = "\n".join(f"- {line}" for line, _ in kept)
        paths = "\n".join(f"- {p}" for p in dict.fromkeys(w for _, w in kept if w))
        return f"{text}\n\nTo read one whole, Read memory:\n{paths}" if paths else text


class _Read(_MemoryTool):
    name: str = "Read memory"
    description: str = "Read one remembered passage or record whole, by its path."
    args_schema: type[BaseModel] = _Path

    def _run(self, path: str) -> str:
        try:
            found = self._user().read(path)
        except NotFoundError:
            return "Nothing has been remembered for this user yet."
        return found.text or found.error or f"Nothing at {path}."


class _Save(_MemoryTool):
    name: str = "Save to memory"
    description: str = (
        "Remember something about this user for later: a preference, a fact about "
        "them, a decision. One plain sentence. Never save passwords, keys or secrets."
    )
    args_schema: type[BaseModel] = _Note

    def _run(self, text: str) -> str:
        saved = self._user().add(text, kind="note")
        return "Memory is unavailable right now." if saved.failed else "Saved."


def memory_tools(user_id: str, *, writes: bool = True) -> list[BaseTool]:
    """The memory tools for one end user's agent: the user is fixed here, by your code,
    and never asked of the model. `writes=False` leaves out Save to memory."""
    tools: list[BaseTool] = [_Search(user_id=user_id), _Read(user_id=user_id)]
    return [*tools, _Save(user_id=user_id)] if writes else tools


def save_result(user_id: str, output: Any) -> None:
    """Keep what a finished crew found, under `user_id`: a crew's output, or text."""
    text = str(getattr(output, "raw", output) or "").strip()
    if not text:
        return
    item = {"id": _id(user_id, text), "kind": "note", "text": text}
    if _memory().user(user_id).add(item).failed:
        log.warning("twin memory unavailable, result not saved")
